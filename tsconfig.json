{
  "compilerOptions": {
    "baseUrl": "./",
    "ignoreDeprecations": "",
    "paths": {
      "@owners/entities/owner.entity": ["src/owners/entities/owner.entity"],
      "@pets/entities/pet.entity": ["src/pets/entities/pet.entity"],
    },
    "types": ["jest", "node"],
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
